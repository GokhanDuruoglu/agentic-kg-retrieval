# LLM endpoint (OpenAI-compatible; Fireworks is the default, see configs/models.yaml)
FIREWORKS_API_KEY=
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1   # override the base_url of configs/models.yaml

# Neo4j holding the 2Wiki graph (see `akg graph load`)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Database name. Neo4j Community has a single database called "neo4j"; Enterprise can use any name.
NEO4J_DATABASE=neo4j
